# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/someip/v1/someip.proto
# proto-message: SomeIpMapping

package: "com.sdv.someip"
some_ip_mapping {
  someip_service_mapping {
    someip_service_id: 0x3100
    version_major: 0x1
    version_minor: 0x0
    instance {
        instance_id: 0x1000
        sdv_service_unit_parameterization {key: 0 value: "com-sdv-someip-road-info-unique"}
    }
    instance_impl {
      offered_event {
        group_id: 0x9310
        event_id: 0x8310
        simple_event {
          sdv_unit_type {
            package_name: "com.sdv.someip"
            service_bundle_name: "SomeIpBroker"
            type_name: "RoadInfo"
          }
          service_unit: 0
          type_definition {
            field {
              field_name: "num_vehicles"
              field_type { someip_primitive: UINT8 }
            }
            field {
              field_name: "vehicle_data"
              field_type {
                someip_array {
                  length_field_size: TWO
                  array_type {
                    someip_struct {
                      field {
                        field_name: "velocity"
                        field_type { someip_primitive: FLOAT32 }
                      }
                      field {
                        field_name: "acceleration"
                        field_type { someip_primitive: FLOAT32 }
                      }
                      field {
                        field_name: "lane"
                        field_type { someip_primitive: UINT8 }
                      }
                    }
                  }
                }
              }
            }
          }
          message_translation_mode: DYNAMIC_LIBRARY
        }
      }
    }
  }
}
