package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "someip_serde_defaults",
    srcs: [
        "src/lib.rs",
    ],
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    rustlibs: [
        "libserde",
        "libnom",
        "libbytes",
        "libbyteorder",
        "libsomeip_config",
        "libthiserror",
        "libsdv_status_rs",
        "libprotobuf",
        "libsomeip_dll_api",
        "libsomeip_serde_reflect",
    ],
    edition: "2021",
    lints: "android",
    clippy_lints: "android",
    system_ext_specific: true,
}

rust_library {
    name: "libsomeip_serde_reflect",
    crate_name: "someip_serde_reflect",
    srcs: [
        "src/reflect.rs",
    ],
    rustlibs: [
        "libsomeip_config",
    ],
    min_sdk_version: "35",
    host_supported: true,
}

rust_test {
    name: "sdv_core_core_services_unit_someip_serde_reflect_test",
    srcs: [
        "src/reflect.rs",
    ],
    rustlibs: [
        "libsomeip_config",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}

rust_library {
    name: "libsomeip_serde",
    crate_name: "someip_serde",
    defaults: ["someip_serde_defaults"],
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_core_core_services_unit_someip_serde_test",
    defaults: ["someip_serde_defaults"],
    rustlibs: [
        "libhex",
        "libgoogletest_rust",
        "libsomeip_serde_test_protos",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}

rust_protobuf {
    name: "libsomeip_serde_test_protos",
    crate_name: "someip_serde_test_protos",
    protos: [
        "**/*.proto",
    ],
    source_stem: "someip_serde_test_protos_source",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    host_supported: true,
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}
