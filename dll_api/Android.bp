package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "libsomeip_dll_api@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libsdv_comms_bindgen",
        "libsdv_status_rs",
        "libbyteorder",
        "libsomeip_config",
    ],
    system_ext_specific: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "35",
}

rust_library {
    name: "libsomeip_dll_api",
    crate_name: "someip_dll_api",
    defaults: ["libsomeip_dll_api@rust_defaults"],
}

rust_test {
    name: "sdv_core_core_services_unit_someip_dll_api_test",
    defaults: ["libsomeip_dll_api@rust_defaults"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
