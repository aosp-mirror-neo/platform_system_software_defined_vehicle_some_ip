package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "someip_config_defaults",
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libserde",
        "libcxx",
    ],
    edition: "2021",
    lints: "android",
    clippy_lints: "android",
    system_ext_specific: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "35",
}

rust_library {
    name: "libsomeip_config",
    crate_name: "someip_config",
    defaults: ["someip_config_defaults"],
    host_supported: true,
}

rust_test {
    name: "sdv_core_core_services_unit_someip_deployment_config_test",
    defaults: ["someip_config_defaults"],
    rustlibs: ["libserde_json"],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_options: {
        unit_test: true,
    },
}

cc_library_headers {
    name: "libsomeip_config_header",
    host_supported: true,
    vendor_available: true,
    generated_headers: ["libsomeip_config_cxx_header"],
    export_generated_headers: ["libsomeip_config_cxx_header"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

genrule {
    name: "libsomeip_config_cxx_header",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) --header >> $(out)",
    srcs: ["src/serde_config.rs"],
    out: ["serde_config_bindings.rs.h"],
}

genrule {
    name: "libsomeip_config_cxx_cpp",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) >> $(out)",
    srcs: ["src/serde_config.rs"],
    out: ["serde_config_generated.cpp"],
}
