package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "vsomeip_stack_defaults",
    host_supported: false,
    shared_libs: [
        "libutils",
        "libbinder_ndk",
        "libvsomeip3",
        "libvsomeip3-cfg",
        "libvsomeip3-sd",
        "liblog",
        "libbase",
        "libsdv_log",
        "google.sdv.someip-V2-ndk",
        "google.sdv.someip_load_indicators-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunused-parameter",
    ],
    vendor: true,
}

cc_binary {
    name: "sdv_someip_stack_agent",
    defaults: ["vsomeip_stack_defaults"],
    srcs: [
        "src/agent.cpp",
        "src/stack.cpp",
    ],
    vintf_fragments: [":sdv_someip_stack_agent_vintf_fragments"],
}

prebuilt_etc {
    name: "vsomeip_config.json",
    sub_dir: "someip",
    src: "vsomeip_config.json",
    vendor: true,
}
