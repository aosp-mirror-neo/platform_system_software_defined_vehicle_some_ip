package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_test {
    name: "sdv_core_core_services_integration_someip_sdv_rpc_test",
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    srcs: ["src/main.rs"],
    rustlibs: [
        "libsdv_mw_rs_com_sdv_google_sample_someip_sdv_integration_test_server",
        "libcom_sdv_google_sample_someip_test_hello_rpc_rs",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_comms",
        "libsdv_comms_rs",
        "libsomeip_messages_catalog",
        "libsdv_someip_integration_test",
        "liblog_rust",
        "libsdv_status_rs",
        "libsdv_log_rust",
        "libtokio",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    // TODO(398771552): Remove authz disabling exception. This should not be used in the new code.
    test_config_template: ":sdv_authz_enforcement_flag_disabled_config_template",
    test_options: {
        unit_test: false,
    },
    ld_flags: ["-Wl,--no-as-needed"],
    product_specific: true,
    require_root: true,
}
