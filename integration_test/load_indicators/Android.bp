package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_test {
    name: "sdv_core_core_services_integration_someip_load_indicators_test",
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    srcs: ["src/main.rs"],
    rustlibs: [
        "google.sdv.someip_load_indicators-V1-rust",
        "libgoogletest_rust",
        "libbinder_rs",
    ],
    test_options: {
        unit_test: false,
    },
    ld_flags: ["-Wl,--no-as-needed"],
    product_specific: true,
    require_root: true,
    test_config_template: ":sdv_authz_enforcement_flag_enabled_config_template",
}
